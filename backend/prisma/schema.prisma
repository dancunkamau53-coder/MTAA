generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String        @id @default(cuid())
  name      String
  email     String        @unique
  phone     String?
  password  String
  role      UserRole      @default(USER)
  status    AccountStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  comments        Comment[]
  likes           Like[]
  notifications   Notification[]
  properties      Property[]
  savedProperties SavedProperty[]

  serviceBlocksReceived   ServiceBlock[]   @relation("ServiceBlockBlocked")
  serviceBlocksMade       ServiceBlock[]   @relation("ServiceBlockBlocker")
  serviceMessages         ServiceMessage[] @relation("ServiceMessageSender")
  serviceProvider         ServiceProvider?
  serviceReports          ServiceReport[]  @relation("ServiceReportReporter")
  customerServiceRequests ServiceRequest[] @relation("ServiceRequestCustomer")
  customerServiceReviews  ServiceReview[]  @relation("ServiceReviewCustomer")

  reviewsWritten  Review[] @relation("ReviewAuthor")
  reviewsReceived Review[] @relation("ReviewTargetUser")
}

model Property {
  id           String   @id @default(cuid())
  title        String
  description  String?
  location     String
  price        Float
  bedrooms     Int?
  bathrooms    Int?
  imageUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  ownerId      String
  latitude     Float?
  longitude    Float?
  parking      Int?
  propertyType String?
  furnished    Boolean?

  comments Comment[]
  likes    Like[]
  owner    User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  images   PropertyImage[]
  videos   PropertyVideo[]
  savedBy  SavedProperty[]
  reviews  Review[]
}

model PropertyImage {
  id         String   @id @default(cuid())
  url        String
  isCover    Boolean  @default(false)
  createdAt  DateTime @default(now())
  propertyId String

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model PropertyVideo {
  id           String   @id @default(cuid())
  url          String
  mimeType     String
  originalName String
  createdAt    DateTime @default(now())
  propertyId   String

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, createdAt])
}

model Like {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  userId     String
  propertyId String

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([propertyId])
  @@index([userId])
}

model SavedProperty {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  userId     String
  propertyId String

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([propertyId])
  @@index([userId])
}

model Comment {
  id         String   @id @default(cuid())
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  userId     String
  propertyId String

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  detail    String
  type      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ServiceProvider {
  id                      String                     @id @default(cuid())
  businessName            String
  description             String
  category                String
  location                String
  businessPhone           String
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  userId                  String                     @unique
  verificationStatus      ProviderVerificationStatus @default(UNVERIFIED)
  verificationRequestedAt DateTime?
  verifiedAt              DateTime?
  verificationNote        String?

  services OfferedService[]
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports  ServiceReport[]
  requests ServiceRequest[]
  reviews  ServiceReview[]

  @@index([verificationStatus, verificationRequestedAt])
}

model OfferedService {
  id          String   @id @default(cuid())
  title       String
  description String
  price       Float
  priceUnit   String   @default("per job")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  providerId  String

  provider ServiceProvider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  reports  ServiceReport[]
  requests ServiceRequest[]

  @@index([providerId, active])
}

model ServiceRequest {
  id          String               @id @default(cuid())
  details     String
  location    String
  status      ServiceRequestStatus @default(REQUESTED)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  customerId  String
  providerId  String
  serviceId   String
  quotedPrice Float?
  proposedAt  DateTime?
  quoteNote   String?

  messages ServiceMessage[]
  customer User             @relation("ServiceRequestCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  provider ServiceProvider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service  OfferedService   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  review   ServiceReview?

  @@index([customerId, createdAt])
  @@index([providerId, status, createdAt])
}

model ServiceReview {
  id         String   @id @default(cuid())
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  requestId  String   @unique
  customerId String
  providerId String

  customer User            @relation("ServiceReviewCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  provider ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  request  ServiceRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([providerId, createdAt])
}

model ServiceReport {
  id         String              @id @default(cuid())
  reason     ServiceReportReason
  details    String
  status     ServiceReportStatus @default(PENDING)
  adminNote  String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  reporterId String
  providerId String
  serviceId  String

  provider ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  reporter User            @relation("ServiceReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  service  OfferedService  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([providerId, status])
}

model ServiceMessage {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  requestId String
  senderId  String

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sender  User           @relation("ServiceMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}

model ServiceBlock {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  blockerId     String
  blockedUserId String

  blockedUser User @relation("ServiceBlockBlocked", fields: [blockedUserId], references: [id], onDelete: Cascade)
  blocker     User @relation("ServiceBlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedUserId])
  @@index([blockedUserId, createdAt])
}

model Review {
  id           String   @id @default(cuid())
  rating       Int
  comment      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  authorId     String
  propertyId   String?
  targetUserId String?

  author     User      @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  targetUser User?     @relation("ReviewTargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([authorId, propertyId])
  @@index([propertyId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([authorId, createdAt])
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum UserRole {
  USER
  OWNER
  AGENT
  CARETAKER
  SERVICE_PROVIDER
  ADMIN
}

enum ServiceRequestStatus {
  REQUESTED
  ACCEPTED
  DECLINED
  COMPLETED
  QUOTED
  QUOTE_DECLINED
}

enum ProviderVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum ServiceReportReason {
  FRAUD
  MISLEADING_INFO
  UNSAFE
  SPAM
  OTHER
}

enum ServiceReportStatus {
  PENDING
  DISMISSED
  ACTIONED
}